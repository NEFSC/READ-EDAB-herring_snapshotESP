library(readr)
all_herring_snapshot_indicators <- read_csv("03_outputs/all_herring_snapshot_indicators.csv")
View(all_herring_snapshot_indicators)
test <- all_herring_snapshot_indicators |>
tidyr::pivot_longer()
test <- all_herring_snapshot_indicators |>
tidyr::pivot_longer(cols = -year)
test <- all_herring_snapshot_indicators |>
tidyr::pivot_longer(cols = -Year)
View(test)
test <- all_herring_snapshot_indicators |>
tidyr::pivot_longer(cols = -Year) |>
dplyr::rename(YEAR = Year,
DATA_VALUE = value,
INDICATOR_NAME = name)
View(test)
write.csv(test, "all_herring_indicators_long.csv", row.names = FALSE)
indicators <- read.csv(here::here("all_herring_indicators_long.csv"))
View(indicators)
